# ── 服务 ───────────────────────────────────────────────
# 对外可访问的站点地址；QQ 回调地址 = PUBLIC_URL + /api/auth/qq/callback
PUBLIC_URL=http://localhost:52188
PORT=52188
# API 监听地址：默认 0.0.0.0，开发时同一局域网内的手机也能直接访问
HOST=0.0.0.0

# ── 前端开发服务器（仅 `pnpm dev` 使用）──────────────────
WEB_PORT=5173
# 设为 127.0.0.1 可关闭局域网访问
WEB_HOST=0.0.0.0
# 需要把 /api、/media 代理到别的地址时填写，默认跟随 PORT
# VITE_API_TARGET=http://127.0.0.1:52188

# ── QQ 登录 ────────────────────────────────────────────
# 登录页默认直连腾讯网页 QQ 扫码（ptlogin2），无需申请应用凭据。
# 下面的官方 QQ 互联参数是可选的，仅用于额外的跳转登录接口。
QQ_APP_ID=
QQ_APP_KEY=

# ── 会话 ──────────────────────────────────────────────
# 登录会话有效期（天）；0 = 永久。永久模式下数据库不设过期，
# Cookie 受浏览器 400 天上限约束，每次打开页面会自动续期。
SESSION_DAYS=0

# ── 本地开发 ──────────────────────────────────────────
# 1 = 开启开发登录入口（生产环境务必留空）
DEV_AUTH=1
DATA_DIR=./data
